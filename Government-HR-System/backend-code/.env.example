# Environment variables for Government HR System backend
# Copy this file to .env and fill in real values. Never commit .env to source control.

# PostgreSQL connection string (required)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://hr_user:CHANGE_ME@localhost:5432/hr_system

# Secret key used to sign JWTs (required) — use a long random string (e.g. openssl rand -hex 64)
JWT_SECRET=CHANGE_ME_USE_A_LONG_RANDOM_SECRET

# JWT token expiry duration (required)
# Examples: 1h, 30m, 2h
JWT_EXPIRY=1h

# URL of the ministry SSO token verification endpoint (required)
# The backend calls this URL to validate SSO tokens before issuing JWTs
SSO_VERIFY_URL=https://sso.ministry.gov.sa/api/verify

# Port the backend HTTP server listens on (required)
PORT=3001

# Comma-separated list of allowed CORS origins (required)
# Example for multiple origins: http://localhost:3000,https://hr.ministry.gov.sa
ALLOWED_ORIGINS=http://localhost:3000